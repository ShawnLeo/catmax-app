# Electron 下载镜像（国内加速，可按需关闭）
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
# better-sqlite3 编译相关
public-hoist-pattern[]=*better-sqlite3*
# 扁平 node_modules（npm 风格）。electron-builder 24.x 不理解 pnpm 的隔离式布局：
# 根 node_modules 下是软链，依赖的依赖躺在 .pnpm/<pkg>/node_modules/ 同级目录里，
# 打包时只会拷到包本体、丢掉全部传递依赖（22 个生产依赖里 12 个缺件，
# 启动即报 Cannot find package 'shell-path'）。改成 hoisted 后 electron-builder 能正常收集。
node-linker=hoisted
# 严格 peer dep
auto-install-peers=true
