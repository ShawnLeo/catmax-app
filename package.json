{
  "name": "catmax-app",
  "version": "0.1.0",
  "description": "Self-hosted code agent client (Electron + Vue3)",
  "private": true,
  "author": "shawn",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm rebuild:native || true && electron-vite dev",
    "build": "pnpm rebuild:native || true && electron-vite build && node scripts/copy-bootstrap.cjs && node scripts/compute-runtime-id.cjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx,.vue --cache",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,cjs,mjs,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3 -w node-pty",
    "rebuild:node": "pnpm rebuild better-sqlite3 node-pty",
    "release:hot": "pnpm build && node scripts/release-hot.mjs",
    "publish:hot": "node scripts/publish-hot.mjs",
    "dit:mac": "pnpm build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --mac",
    "dist:win": "pnpm build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win",
    "dist": "pnpm build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder"
  },
  "//dependencies": "只放主进程/preload 在运行时真正 require 的包。electron-vite 的 externalizeDepsPlugin 按 dependencies 决定谁不被 bundle，electron-builder 也按 dependencies 收集 node_modules——渲染进程的包已被 vite 打进 out/renderer，留在这里只会让安装包白白多几十 MB。加新依赖前先确认它出现在 out/main/index.js 的 require 里。",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.218",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.3.9",
    "fix-path": "^5.0.0",
    "ignore": "^7.0.6",
    "node-pty": "^1.1.0",
    "simple-git": "^3.36.0",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/rebuild": "^4.2.0",
    "@git-diff-view/file": "^0.1.7",
    "@git-diff-view/lowlight": "^0.1.7",
    "@git-diff-view/vue": "^0.1.7",
    "@rushstack/eslint-patch": "^1.10.4",
    "@shikijs/markdown-it": "^1.27.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.5.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.28.0",
    "happy-dom": "^15.0.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.0",
    "material-icon-theme": "^5.37.0",
    "pinia": "^2.2.0",
    "postcss": "^8.4.41",
    "prebuild-install": "^7.1.3",
    "prettier": "^3.3.0",
    "radix-vue": "^1.9.17",
    "shadcn-vue": "^0.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "unplugin-auto-import": "^0.18.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vue-tsc": "^2.1.0",
    "zod": "^3.25.30"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "node-pty"
    ],
    "supportedArchitectures": {
      "os": [
        "darwin",
        "win32"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  }
}
